# Database
DATABASE_URL="postgresql://user:password@localhost:5432/uploadhost"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-change-in-production"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# S3-Compatible Storage (Cloudflare R2 recommended)
S3_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="uploadhost-files"
S3_REGION="auto"
S3_PUBLIC_URL="https://files.uploadhost.site"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="no-reply@uploadhost.site"
SMTP_PASS="your-smtp-password"
SMTP_FROM="UploadHost <no-reply@uploadhost.site>"

# App
NEXT_PUBLIC_APP_URL="https://uploadhost.site"
NEXT_PUBLIC_APP_NAME="UploadHost"
